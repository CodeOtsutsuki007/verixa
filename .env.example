# Copy to .env and adjust as needed. apps/api reads these via @verixa/config
# (packages/config), which validates them at startup and fails fast with a
# readable error if anything required is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Interface the API binds to. 0.0.0.0 to accept connections from any host
# (default, needed inside Docker); 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Read by @verixa/config (validated, defaults to this value) but not yet
# consumed by any repository — that starts with Issue 046. Matches the
# `verixa` database docker-compose.yml provisions for local development.
DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa

# Only used by test code (never by the running app) — points at the
# separate `verixa_test` database docker-compose.yml also provisions, so
# tests never run against the same database a developer is interactively
# using. See docs/guides/database.md.
TEST_DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa_test

# Redis connection for the sessions context (Phase 05): the revocation
# deny-list (@verixa/sessions RedisRevocationList) stores one short-lived key
# per revoked session here. The adapter exists now; the composition root wires
# a client to it in a later issue, so the running API does not read this yet.
REDIS_URL=redis://localhost:6379

# Only used by test code (never by the running app) — points the sessions
# Redis integration tests at a real Redis. Unset it and, without Docker for
# Testcontainers, those tests skip. Mirrors TEST_DATABASE_URL.
TEST_REDIS_URL=redis://localhost:6379

# JWT signing keys for access tokens (Phase 05, Issue 085), as a JSON array.
# Validated by @verixa/config (loadSigningKeys) and consumed by the sessions
# SigningKeyProvider. Not yet read by the running app — token issuance is wired
# up in a later issue — but validated whenever present.
#
# Exactly one key is the current signer (needs a private key); any others are
# retired, verification-only (public key only) so tokens signed just before a
# rotation keep verifying. Rotate by adding a new current key and demoting the
# old one to verification-only. Each object is:
#   { "kid": "...", "algorithm": "RS256",
#     "publicKey": "<SPKI PEM>", "privateKey": "<PKCS#8 PEM>", "current": true }
# PEM newlines are written as \n inside the JSON string. THE PRIVATE KEY IS A
# REAL SECRET — use a secrets manager in production, never commit one. See
# docs/security/token-design.md for the algorithm choice and rotation procedure.
# TOKEN_SIGNING_KEYS=[{"kid":"2026-09-a","algorithm":"RS256","publicKey":"<SPKI PEM>","privateKey":"<PKCS#8 PEM>","current":true}]

# --- Stellar audit-log anchoring (optional) ---
# Used by @verixa/stellar-anchor to commit audit-log hash-chain tips to the
# Stellar ledger, so the log's integrity can be verified by a third party
# without trusting this deployment's database. Entirely optional: leave
# unset to run with anchoring disabled. See docs/guides/stellar-anchoring.md
# and docs/adr/0003-stellar-audit-anchoring.md.

# "testnet" or "public".
STELLAR_NETWORK=testnet

# Where the anchoring key lives. Two options:
#   local — this process holds the key, read from STELLAR_ANCHOR_SECRET_KEY.
#           Testnet and development only.
#   kms   — the key never enters this process; a KmsTransactionSigner built
#           with your cloud key service is supplied at composition time
#           (buildContainer(undefined, { signer })). This is what production
#           should use; the SDK client belongs to the deployment, not here.
# Unset means local when STELLAR_ANCHOR_SECRET_KEY is present, and no signing
# at all otherwise. See docs/security/stellar-key-management.md for why an
# environment variable is not key management.
STELLAR_SIGNING_BACKEND=local

# Secret key (S...) of the funded account anchoring transactions are sent
# from. THIS IS A REAL SECRET — anyone holding it can drain the account and
# forge anchors. Use STELLAR_SIGNING_BACKEND=kms in production; never commit
# it, never log it. Anchoring is disabled when unset. Verification needs no
# key at all, so an auditor never sets any of these.
STELLAR_ANCHOR_SECRET_KEY=

# On the public network, local signing is refused at startup unless this is
# set to 1. Leaving it unset is the safe default: mainnet anchors should come
# from a KMS or HSM. Set it only if you accept that anything able to read this
# process's environment holds a key that mints publicly-verifiable claims.
# STELLAR_ALLOW_LOCAL_SIGNING=1

# --- Audit write throughput (optional) ---
# See docs/performance/audit-write-throughput.md for the trade-off: batching
# makes entries durable on flush rather than per request, so it is opt-in.

# 1 to batch audit writes through BatchedAuditWriter. Unset (default) writes
# each event as it happens.
# AUDIT_BATCHED_WRITES=1

# Tuning knobs for the batched writer. Only read when it is enabled, and a
# malformed value falls back to the documented default rather than stopping
# the API from starting.
# AUDIT_MAX_BATCH_SIZE=100
# AUDIT_FLUSH_INTERVAL_MS=250
# AUDIT_MAX_QUEUE_SIZE=10000
