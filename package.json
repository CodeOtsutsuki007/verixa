{
  "name": "verixa",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source infrastructure for authentication, authorization, identity, verification, audit logging, security, and governance.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prepare": "husky && pnpm --filter @verixa/database run db:generate",
    "db:wait": "node scripts/db-wait.mjs",
    "db:generate": "pnpm --filter @verixa/database run db:generate",
    "db:migrate": "pnpm --filter @verixa/database run db:migrate",
    "db:migrate:deploy": "pnpm --filter @verixa/database run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @verixa/database run db:migrate:status",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @verixa/api^... run build && pnpm --filter @verixa/api run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:benchmark": "pnpm --filter @verixa/identity run benchmark",
    "db:benchmark:audit": "pnpm --filter @verixa/database run benchmark:audit",
    "audit:verify-chain": "pnpm --filter @verixa/audit^... run build && pnpm --filter @verixa/audit run verify-chain"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.1"
  }
}
