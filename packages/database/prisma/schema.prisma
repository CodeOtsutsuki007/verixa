// Verixa's database schema. One schema, one migration history, one database —
// see docs/adr/0002-multi-tenancy-model.md: every tenant shares these tables,
// isolated by a row-level `organization_id` plus Postgres RLS, rather than by
// separate schemas or databases per tenant.
//
// Tables arrive one issue at a time, each as its own migration: users (043),
// organizations/memberships (044), invitations (045). See
// docs/guides/database.md for the migration workflow.

// Generates to the default location (node_modules/.prisma/client, re-exported
// by @prisma/client) rather than a custom `output` path inside this package.
// That matters for the build: a custom output directory would be imported by
// relative path from index.ts, which then breaks in the compiled dist/ output
// because the generated files aren't copied there by tsc. Resolving through
// node_modules works identically from source and from dist.
generator client {
  provider        = "prisma-client-js"
  // `postgresqlExtensions` is what lets the datasource below declare `citext`,
  // so Prisma emits the CREATE EXTENSION into the migration rather than
  // requiring every developer to run it by hand against their local database.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

/// Lifecycle states a user can occupy. Mirrors the `UserStatus` union in
/// packages/identity/domain/entities/user.ts — the domain owns which
/// transitions between these are legal (`ALLOWED_TRANSITIONS`); the database
/// only guarantees the column holds one of the four, never an arbitrary
/// string. Values are lowercase to match the domain's union exactly, so no
/// mapping layer is needed in either direction.
enum UserStatus {
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

/// The identity aggregate's persisted form. Maps to the `User` entity in
/// packages/identity/domain/entities/user.ts.
model User {
  /// Assigned by the domain (`createId<"UserId">()`), never by the database —
  /// deliberately no `@default(uuid())`. An aggregate owns its own identity:
  /// `User.register()` produces a fully-formed, valid User *before* anything
  /// touches persistence, which is what lets the domain layer be tested and
  /// reasoned about without a database at all. A database-generated id would
  /// invert that, making an entity only partially real until it was saved.
  id String @id @db.Uuid

  /// `citext` (case-insensitive text) rather than `text`, so the unique index
  /// treats Alice@Example.com and alice@example.com as the same address at the
  /// database level.
  ///
  /// The domain already lowercases in `Email.create()`, so in normal operation
  /// every value here is already lowercase and citext changes nothing. It
  /// earns its place as the second line of defense: a raw SQL insert, a data
  /// migration, a bulk import, or a future code path that bypasses
  /// `Email.create()` would otherwise be able to create a duplicate account
  /// differing only in case — which is an account-takeover-adjacent bug, not a
  /// cosmetic one.
  ///
  /// The common alternative is `text` plus a functional unique index on
  /// `LOWER(email)`. That works for uniqueness but is a well-known footgun:
  /// the index is only used when a query's WHERE clause matches its
  /// expression exactly, so `WHERE email = $1` silently falls back to a
  /// sequential scan while `WHERE LOWER(email) = LOWER($1)` uses the index.
  /// Every query site then has to remember the LOWER() wrapper, and the one
  /// that forgets is both slow and case-sensitive. citext moves that
  /// correctness into the column type, where it can't be forgotten.
  email String @unique @db.Citext

  /// The name shown throughout the product. Always present.
  displayName String @map("display_name")

  /// Optional structured legal name. Both parts are nullable because
  /// `PersonName` itself is optional on a User; see the entity for why
  /// `familyName` is optional even when a person name is present.
  givenName  String? @map("given_name")
  familyName String? @map("family_name")

  status UserStatus

  /// `timestamptz`, not `timestamp`. Postgres's `timestamp` (which is Prisma's
  /// default for DateTime) stores no timezone and silently reinterprets values
  /// against whatever the session timezone happens to be — a classic source of
  /// hour-shifted timestamps that only appear when a server, a developer
  /// laptop, and a CI runner disagree about local time. Audit and identity
  /// records need an unambiguous instant.
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  /// Set when the user is soft-deleted; NULL otherwise (Issue 054). Rows are
  /// never removed — everything referencing a user by id must stay
  /// resolvable, and `organizations.owner_id` is ON DELETE RESTRICT precisely
  /// because hard deletion isn't how accounts go away here.
  ///
  /// Indexed because the erasure/retention job (Phase 24) scans by it: "every
  /// user deleted more than N days ago" is a range query over this column.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  credential              Credential?
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  memberships             OrganizationMembership[]
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaMethods              MfaMethod[]
  roleAssignments         UserRoleAssignment[]
  verificationRequests    VerificationRequest[]    @relation("VerificationRequestSubject")
  sessions                Session[]

  @@index([deletedAt])
  @@map("users")
}

/// Mirrors the `OrganizationStatus` union in
/// packages/identity/domain/entities/organization.ts.
enum OrganizationStatus {
  active
  suspended
  deleted

  @@map("organization_status")
}

/// Mirrors the `MembershipStatus` union in
/// packages/identity/domain/entities/organization-membership.ts.
enum MembershipStatus {
  active
  revoked

  @@map("membership_status")
}

/// The multi-tenancy aggregate root. Maps to the `Organization` entity in
/// packages/identity/domain/entities/organization.ts.
model Organization {
  id String @id @db.Uuid

  name String

  /// `citext` for the same reason as `User.email`: the domain lowercases in
  /// `Organization.create()`, so this only matters when something bypasses
  /// that path — but two organizations whose slugs differ only in case would
  /// collide in any case-insensitive URL routing, and "acme" vs "ACME" as
  /// distinct tenants is a tenant-confusion bug rather than a cosmetic one.
  slug String @unique @db.Citext

  ownerId String @map("owner_id") @db.Uuid

  status OrganizationStatus

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  /// `Restrict`, deliberately — deleting a user who still owns an
  /// organization must fail rather than cascade. Cascading here would mean
  /// erasing one user's account silently destroys an entire organization
  /// (and, transitively, every other member's access to it), which is
  /// catastrophic and irreversible. Ownership has to be transferred first;
  /// forcing that as a hard database error is the point.
  owner User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  memberships          OrganizationMembership[]
  invitations          Invitation[]
  roles                Role[]
  verificationRequests VerificationRequest[]    @relation("VerificationRequestOrganization")

  @@map("organizations")
}

/// The join entity linking a user to an organization. Maps to
/// packages/identity/domain/entities/organization-membership.ts.
model OrganizationMembership {
  id String @id @db.Uuid

  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  status MembershipStatus

  joinedAt DateTime @map("joined_at") @db.Timestamptz(3)

  /// `Cascade` on both sides, unlike `Organization.owner` above. A membership
  /// is meaningless without the user or the organization it links — an
  /// orphaned row would be unreadable garbage rather than recoverable data,
  /// so cascading is cleanup, not loss.
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Indexes for the two lookups the repository port actually performs:
  /// "every membership in this organization" and "this user's membership in
  /// this organization."
  @@index([organizationId])
  @@index([userId, organizationId])
  @@map("organization_memberships")
}

model Permission {
  id          String           @id @db.Uuid
  key         String           @unique
  description String
  createdAt   DateTime         @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String               @id @db.Uuid
  name           String
  description    String
  isSystemRole   Boolean              @map("is_system_role")
  organizationId String?              @map("organization_id") @db.Uuid
  createdAt      DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @map("updated_at") @db.Timestamptz(3)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  assignments    UserRoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  assignedAt     DateTime  @map("assigned_at") @db.Timestamptz(3)
  assignedBy     String?   @map("assigned_by") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// Mirrors the `InvitationStatus` union in
/// packages/identity/domain/entities/invitation.ts.
enum InvitationStatus {
  pending
  accepted
  revoked

  @@map("invitation_status")
}

/// A pending invitation to join an organization. Maps to the `Invitation`
/// entity in packages/identity/domain/entities/invitation.ts.
model Invitation {
  id String @id @db.Uuid

  organizationId  String @map("organization_id") @db.Uuid
  invitedByUserId String @map("invited_by_user_id") @db.Uuid

  email String @db.Citext

  /// The SHA-256 hash of the invitation token — **never the token itself**.
  ///
  /// The raw token is a bearer credential: whoever presents it is treated as
  /// the invited party. Storing it in plaintext would mean anyone who can
  /// read this table (a leaked backup, a SQL-injection read, an overly broad
  /// analytics grant, a support engineer with production access) could accept
  /// invitations as someone else. Storing only the hash means a database
  /// disclosure reveals nothing usable: the hash cannot be presented to
  /// accept an invitation, and cannot be reversed into something that can.
  ///
  /// Short-lived is not an excuse to skip this. A 7-day window is more than
  /// enough to exploit a leaked token, and "it expires eventually" is not a
  /// security property anyone should rely on.
  ///
  /// Plain SHA-256 rather than a slow KDF like argon2 (which passwords will
  /// use in Phase 04) is deliberate and the distinction matters: a slow hash
  /// defends against *offline brute force* of low-entropy secrets that humans
  /// chose. This token is 128 bits of `randomUUID()` entropy, so brute force
  /// is not a threat model, and a fast hash keeps lookup a single indexed
  /// query. See docs/security/token-storage.md.
  tokenHash String @unique @map("token_hash")

  status InvitationStatus

  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// `Restrict`: an invitation records *who* invited someone, which is
  /// audit-relevant provenance. Cascading would silently erase that history
  /// when an inviter's account is removed.
  invitedByUser User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  /// Supports the expiry sweep ("which pending invitations have lapsed") and
  /// the per-organization listing, without a sequential scan in either case.
  @@index([expiresAt])
  @@index([organizationId, status])
  @@map("invitations")
}

/// How a user proves who they are. Separate from `User` deliberately — see
/// packages/credentials/domain/entities/credential.ts.
///
/// One-to-one *optional*: a user may have no credential at all. SSO-only,
/// passkey-only, and service accounts are all legitimately password-less, and
/// modelling that as an absent row states it exactly, where a nullable column
/// on `users` would state it only by convention.
model Credential {
  id String @id @db.Uuid

  /// Unique, enforcing one password credential per user at the database
  /// level. A second row would mean two valid passwords for one account, with
  /// nothing to say which is authoritative.
  userId String @unique @map("user_id") @db.Uuid

  /// The full PHC string (`$argon2id$v=19$m=...$salt$hash`), not a bare
  /// digest. Parameters and salt travel with it, which is what keeps old
  /// hashes verifiable after the cost settings are raised.
  passwordHash String @map("password_hash")

  /// Consecutive failed logins since the last success (Issue 067). Reset to
  /// zero by a successful login, and by a password change.
  ///
  /// Keeps climbing while the credential is locked rather than stopping at
  /// the threshold — that is what makes the backoff exponential, since each
  /// further attempt earns a longer next lock.
  failedAttempts Int @default(0) @map("failed_attempts")

  /// When the current lock expires. Null means not locked.
  ///
  /// Stored as an expiry rather than a boolean so locks release themselves.
  /// A `locked` flag would need a scheduled job to clear it, and the failure
  /// mode of that job not running is an account locked out permanently with
  /// nothing in the request path to notice.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  /// Password history for reuse prevention (Issue 072). Ordered most-recent
  /// first: ["current_hash_that_moved_to_history", "older_hash", ...].
  /// Capped at PasswordHistoryPolicy.depth (default 5) entries.
  ///
  /// Stored as JSON array of strings (PHC hash strings).
  passwordHistory Json @default("[]") @map("password_history")

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  /// `Cascade`, unlike most relations here. A credential has no meaning
  /// without its user, and leaving an orphaned password hash behind after a
  /// user is erased would be retaining exactly the data that most needed to
  /// go.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// Proof that someone controls the email address they registered with
/// (Issue 068).
///
/// Only the SHA-256 digest is stored, never the token. A leaked table is
/// therefore useless: the raw value exists exactly once, in the email that
/// was sent, and is unrecoverable from here.
model EmailVerificationToken {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// Hex-encoded SHA-256. Unique so a digest collision -- or a replayed
  /// insert -- is a constraint violation rather than two tokens that both
  /// work.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// When the token was redeemed. Null means unused.
  ///
  /// A timestamp rather than a `used` boolean, because "when" is what an
  /// audit answers questions with, and the boolean is derivable from it while
  /// the reverse is not.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)

  /// `Cascade`: a verification token for a deleted user is unusable by
  /// definition, and keeping it would retain a link between an address and an
  /// account that no longer exists.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "the outstanding tokens for this user", which both the reissue
  /// path and the Phase 24 retention sweep need.
  @@index([userId])
  /// Supports the expiry sweep.
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Authority to set a new password without knowing the old one (Issue 069).
///
/// The most dangerous token in the system: holding one is equivalent to
/// holding the account. Same storage rules as above, a much shorter lifetime,
/// and the same single-use guarantee.
model PasswordResetToken {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Lifecycle state of a session (Issue 083).
/// Mirrors the `SessionStatus` union in packages/sessions/domain/entities/session.ts.
enum SessionStatus {
  active
  revoked

  @@map("session_status")
}

/// An authenticated user's session, tracking its lifecycle from creation through
/// expiry or explicit revocation (Issue 083). Maps to the `Session` aggregate in
/// packages/sessions/domain/entities/session.ts.
///
/// Sessions are lightweight: they only store the user reference, timing metadata,
/// and status. Session tokens (access tokens, refresh tokens) are issued from
/// sessions but stored separately (refresh tokens in Phase 05, revocation deny-list
/// in Phase 05 Issue 088).
///
/// ### Indexing strategy for "active sessions per user" queries
///
/// The primary index `(userId, expiresAt)` supports the most common query:
/// "fetch all non-expired sessions for a user" (used by Issue 095 "list devices",
/// Issue 094 "session limits", etc.). By sorting on both columns, a query like
///
///   SELECT * FROM sessions WHERE userId = ? AND status = 'active' AND expiresAt > now()
///
/// uses a single index scan without a secondary sort. This avoids a sequential
/// table scan in high-session-count scenarios (e.g., a power user with many devices).
///
/// The secondary index on `expiresAt` alone supports the background expiry sweep
/// (not shown here, Phase 24 equivalent) to clean up or archive stale rows without
/// a full table scan.
///
/// ### Row-Level Security (RLS) awareness
///
/// Sessions belong to users, who belong to organizations. A session should never be
/// readable across tenant boundaries. Once Issue 052 (RLS) is implemented, a Postgres
/// policy will be added to enforce this: sessions are only readable by the owning
/// user or by the owning organization's members with appropriate scope. For now,
/// this is documented as a constraint; the policy itself is added when the RLS
/// infrastructure exists.
model Session {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// When the session was created.
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  /// When the session was last active (accessed, or touched by request handling).
  /// Updated by the application on each request, used for activity-based metrics
  /// and for sliding-window expiry calculations.
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  /// When the session expires. Computed at creation (and optionally extended by
  /// activity under a sliding-expiry policy). After this instant passes, the
  /// session is no longer valid, even if `status` is still `active`.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// When the session was explicitly revoked, if at all. Null means not revoked.
  /// Once set, the session is permanently invalid regardless of `expiresAt`.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  status SessionStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fast lookup for "active sessions per user" (used by Issue 095 "list devices",
  /// Issue 094 "session limits", Issue 092 "log out everywhere", etc.).
  /// Sorted on both columns means range queries like
  ///   WHERE userId = ? AND status = 'active' AND expiresAt > now()
  /// use this index without a secondary sort.
  @@index([userId, expiresAt])
  /// Supports background expiry sweep (Issue 024 Phase equivalent).
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only, hash-chained record of security-relevant events (Phase 10).
///
/// Each row commits to its predecessor, so altering or removing one breaks
/// every hash after it. That makes the log tamper-*evident* -- not
/// tamper-proof, since an attacker with write access could rewrite the whole
/// chain consistently. Closing that gap is what anchoring the head to Stellar
/// is for; see AnchorRecord below and docs/adr/0003-stellar-audit-anchoring.md.
model AuditLogEntry {
  id String @id @db.Uuid

  /// Position in the chain, from 1. **Unique**, not merely indexed: two
  /// concurrent appends built from the same predecessor would both claim the
  /// same sequence, and this constraint is what turns that race into a failed
  /// insert rather than a silently forked chain.
  sequence Int @unique

  action String

  /// Who did it, and to whom. Plain strings, not foreign keys -- an audit row
  /// must survive the deletion of the user it refers to, and an FK with
  /// CASCADE would erase exactly the evidence that matters most.
  actorId   String? @map("actor_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid

  /// Contextual detail, hashed along with everything else. Flat string map so
  /// the canonical form is unambiguous across languages.
  metadata Json

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)

  /// The predecessor's hash. Sixty-four zeroes for the first entry.
  previousHash String @map("previous_hash")

  /// SHA-256 over this entry's canonical form, including previousHash.
  hash String @unique

  @@index([occurredAt])
  @@index([actorId])
  @@index([subjectId])
  @@map("audit_log_entries")
}

/// A commitment of the audit log's head hash to an external ledger.
///
/// Keeping these as rows rather than a single mutable "latest anchor" gives
/// the operator a history: each record proves the log's state at one moment,
/// and an auditor can check any of them independently against the ledger.
model AnchorRecord {
  id String @id @db.Uuid

  /// Chain position this anchor covers. Everything at or below it is
  /// committed to, because the chain links them.
  sequence  Int
  chainHash String @map("chain_hash")

  /// The Stellar transaction hash. Opaque here on purpose -- this table knows
  /// it is a handle, not what ledger it belongs to.
  anchorRef String @unique @map("anchor_ref")

  /// e.g. "stellar:testnet". Recorded because a testnet anchor is not a
  /// mainnet one, and a row that did not say which would be misleading
  /// evidence.
  network String

  anchoredAt DateTime @map("anchored_at") @db.Timestamptz(3)

  @@index([sequence])
  @@map("anchor_records")
}

/// Mirrors the MfaMethodType union in packages/mfa/domain/entities/mfa-method.ts
enum MfaMethodType {
  totp
  webauthn
  backup_codes @map("backup-codes")

  @@map("mfa_method_type")
}

/// Mirrors the MfaMethodStatus union in packages/mfa/domain/entities/mfa-method.ts
enum MfaMethodStatus {
  pending
  active
  disabled

  @@map("mfa_method_status")
}

/// A second factor enrolled by a user (Issue 107).
///
/// TOTP secrets are encrypted at rest using AEAD, not hashed.
/// The server must decrypt them to compute expected codes during login, but
/// a compromised database backup alone should not reveal the plaintext secrets.
model MfaMethod {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  type   MfaMethodType
  status MfaMethodStatus

  /// The encrypted TOTP secret. Only populated for type=totp.
  /// Stored as a base64 encoded string of the ciphertext + IV + auth tag,
  /// or whatever format the encryption utility produces.
  secret String?

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("mfa_methods")
}

/// Mirrors the VerificationTypeValue union in
/// packages/verification/domain/value-objects/verification-type.ts. Prisma
/// enum member names cannot contain a hyphen, so the domain's
/// `identity-document` is stored as `identity_document`; the one translation
/// between the two lives in the verification persistence mapper.
enum VerificationType {
  identity_document
  address
  liveness

  @@map("verification_type")
}

/// Mirrors the VerificationStatusValue union in
/// packages/verification/domain/value-objects/verification-status.ts. The
/// transition table that governs movement between these lives in the domain;
/// the database only guarantees the column holds one of the six.
enum VerificationStatus {
  pending_evidence
  submitted
  in_review
  needs_more_info
  approved
  rejected

  @@map("verification_status")
}

/// The terminal outcomes a review can record. A subset of VerificationStatus:
/// `needs_more_info` is not a decision, it re-opens the request.
enum VerificationDecision {
  approved
  rejected

  @@map("verification_decision")
}

/// One subject's request to prove one thing, and the reviewer claim and
/// decision attached to it. Maps to the `VerificationRequest` aggregate in
/// packages/verification/domain/entities/verification-request.ts.
///
/// `assigned_reviewer_id` is a plain UUID with no `reviewers` table behind it,
/// because whether the caller is a reviewer at all is Phase 07's RBAC concern;
/// this column records *which* case a reviewer holds, not whether they may.
/// Keeping it (and the decided-by column) as bare UUIDs also means a
/// verification record survives the deletion of the reviewer who handled it,
/// the same reasoning the audit log uses for its actor/subject columns.
model VerificationRequest {
  /// Assigned by the domain (`createId<"VerificationRequestId">()`), never by
  /// the database. See the equivalent note on `User.id`.
  id String @id @db.Uuid

  subjectUserId  String @map("subject_user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  type   VerificationType
  status VerificationStatus

  /// The reviewer currently holding a (time-bounded) claim, or NULL when the
  /// case is unclaimed or its claim has lapsed. A claim is a lease, not a
  /// lock: `claim_expires_at` releases it without a scheduled job.
  assignedReviewerId String?   @map("assigned_reviewer_id") @db.Uuid
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz(3)
  claimExpiresAt     DateTime? @map("claim_expires_at") @db.Timestamptz(3)

  /// The terminal decision, if one was reached. `decided_by_reviewer_id` is a
  /// bare UUID for the same reason as `assigned_reviewer_id` above.
  decidedByReviewerId String?               @map("decided_by_reviewer_id") @db.Uuid
  decidedAt           DateTime?             @map("decided_at") @db.Timestamptz(3)
  decision            VerificationDecision?
  /// The mandatory rationale recorded with a decision. Kept alongside the
  /// decision so an auditor reading the row does not need a join, and so the
  /// record answers "why" without a follow-up query.
  decisionNote        String?               @map("decision_note")

  /// What the reviewer asked for when the request is `needs_more_info`.
  /// Visible to the subject; NULL in every other state.
  needsMoreInfoNote String? @map("needs_more_info_note")

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  /// `Cascade`: a verification request has no meaning once its subject or its
  /// tenant is gone, and leaving PII-adjacent rows behind after erasure would
  /// retain exactly the data that needed to go.
  subject      User         @relation("VerificationRequestSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  organization Organization @relation("VerificationRequestOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  /// "This subject's verification history."
  @@index([subjectUserId])
  /// The reviewer queue's ordering key: "oldest in_review first", and the
  /// status filter that narrows to claimable rows. Composite so the queue
  /// query can be served by the index alone.
  @@index([status, createdAt])
  /// Tenant-scoped listings (row-level security scopes every read by org).
  @@index([organizationId])
  /// "Does this reviewer hold an active claim?" — the one-at-a-time check.
  @@index([assignedReviewerId, claimExpiresAt])
  @@map("verification_requests")
}
